# SECRET. Local MySQL. Never commit the real URL.
DATABASE_URL=mysql://user:password@localhost:3306/stamp
# SECRET. Only for a database that needs TLS, such as Aiven: put ?ssl-mode=REQUIRED on DATABASE_URL and paste the
# PEM text of the database's CA here. Without ?ssl-mode in the URL there is no TLS and this is not used. With ?ssl-mode
# and no CA, the server's certificate is checked against the CAs Node trusts, and a database with its own CA is refused.
DB_SSL_CA=

# SECRET. Required only when AGENT_MODE=real. Leave empty for stub.
OPENAI_API_KEY=
# CONFIG. Not secrets.
OPENAI_MODEL_FAST=gpt-4.1-mini
OPENAI_MODEL_STRONG=gpt-4.1
TAVILY_API_KEY=

# CONFIG. CORS origin of the web app.
WEB_ORIGIN=http://localhost:5173
DAILY_RUN_CAP=10
ENABLE_BROWSER_AGENT=false
PORT=3000
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60
# 0 locally. Set TRUST_PROXY_HOPS=1 on Render.
TRUST_PROXY_HOPS=0
NODE_ENV=development
AGENT_MODE=stub
AGENT_RUN_BUDGET_MS=120000
AGENT_EXTRACT_CONCURRENCY=5
AGENT_PROBE=on
