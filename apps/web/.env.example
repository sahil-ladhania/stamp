# Base URL of the Stamp API, with no trailing slash. Every VITE_ variable is public: never put a secret here.
#
# Development: leave empty. The Vite dev server proxies /api to http://localhost:3000,
# so the browser only talks to its own origin and CORS never applies.
#
# Production: the API origin, for example https://stamp-api.up.railway.app.
# The API allows only the origin set in its WEB_ORIGIN variable, so that must equal this app's origin.
VITE_API_URL=

# Optional repository link for the footer (public). Leave empty to hide the Project group.
VITE_REPO_URL=
